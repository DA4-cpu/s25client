+        // construction (see GetNeighbourCandidates) at least one such neighbor always exists.
+        int bestDelta = all.front().distanceDelta;
+        for(const auto& c : all)
+        {
+            bestDelta = std::min(bestDelta, c.distanceDelta);
+        }
+        for(const auto& c : all)
+        {
+            if(c.distanceDelta == bestDelta)
+            {
+                allowed.push_back(c);
+            }
+        }
+    }
+
+    std::vector<DirectionCandidate> preferred;
+    for(const auto& c : allowed)
+    {
+        if(c.dir != cameFrom)
+        {
+            preferred.push_back(c);
+        }
+    }
+    if(preferred.empty())
+    {
+        preferred = allowed;
+    }
+
+    if(consecutiveStraightSteps >= MaxConsecutiveStraightSteps)
+    {
+        // Breaking a long straight run takes priority over avoiding a reversal: try (allowed minus
+        // lastMoveDir minus cameFrom) first, then (allowed minus lastMoveDir), and only fall back to
+        // allowing straight-continuation if truly nothing else qualifies without breaking the budget.
+        std::vector<DirectionCandidate> noStraightNoReverse;
