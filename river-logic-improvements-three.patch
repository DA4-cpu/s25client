+/// length budget beyond what's strictly needed to reach the sea from here (see CreateStream). Only
+/// candidates that keep the stream within that budget are ever considered - this is what guarantees it
+/// always reaches the sea in time - and, among those, it prefers not to immediately reverse (unless
+/// that's the only remaining option), and prefers to turn rather than continue straight once it's gone
+/// straight for "consecutiveStraightSteps" already (again unless that's the only remaining option).
+Direction ChooseDirection(RandomUtility& rnd, const Map& map, const NodeMapBase<unsigned>& distanceToSea,
+                           const MapPoint& currentNode, Direction cameFrom, Direction lastMoveDir,
+                           unsigned consecutiveStraightSteps, int slack)
+{
+    const auto all = GetNeighbourCandidates(map, distanceToSea, currentNode);
+
+    std::vector<DirectionCandidate> allowed;
+    for(const auto& c : all)
+    {
+        if(c.distanceDelta <= slack - 1)
