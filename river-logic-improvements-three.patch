+/// Collects all 6 neighbors of "currentNode" together with how their distance-to-sea compares to
+/// "currentNode" itself. Adjacent nodes always differ by at most 1 in a plain grid BFS distance field,
+/// so distanceDelta is always exactly -1, 0 or +1 - and, crucially, at least one neighbor always has
+/// distanceDelta == -1 (that's how "currentNode" itself got its own distance value in the first
+/// place). That's what guarantees the stream can always keep making progress towards the sea.
+std::vector<DirectionCandidate> GetNeighbourCandidates(const Map& map, const NodeMapBase<unsigned>& distanceToSea,
+                                                        const MapPoint& currentNode)
+{
+    const auto currentDistance = static_cast<int>(distanceToSea[currentNode]);
+
+    std::vector<DirectionCandidate> all;
+    all.reserve(6);
+    for(Direction dir : helpers::EnumRange<Direction>())
+    {
+        const auto neighbour = map.getTextures().GetNeighbour(currentNode, dir);
+        const auto delta = static_cast<int>(distanceToSea[neighbour]) - currentDistance;
+        all.push_back(DirectionCandidate{dir, neighbour, delta, static_cast<unsigned>(map.z[neighbour])});
+    }
+    return all;
