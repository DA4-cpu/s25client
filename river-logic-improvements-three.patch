+
+/// Picks among the given candidates, favoring lower terrain height for a more natural-looking path.
+/// Candidates that don't make progress towards the sea (distanceDelta >= 0) get a lower base weight,
+/// but never zero - they're only ever passed in here at all when actually taking them keeps the stream
+/// within its length budget (see ChooseDirection), so this never risks the guarantee of arrival.
+Direction WeightedPickByHeight(RandomUtility& rnd, const std::vector<DirectionCandidate>& candidates)
+{
+    unsigned highest = 0;
+    for(const auto& c : candidates)
+    {
+        highest = std::max(highest, c.height);
+    }
+
+    unsigned totalWeight = 0;
+    std::vector<unsigned> weights;
+    weights.reserve(candidates.size());
+    for(const auto& c : candidates)
+    {
+        const unsigned heightWeight = highest - c.height + 1;
+        const unsigned progressWeight = (c.distanceDelta > 0) ? 1u : 2u;
+        const unsigned weight = heightWeight * progressWeight;
+        weights.push_back(weight);
+        totalWeight += weight;
+    }
+
+    unsigned roll = rnd.RandomValue(0u, totalWeight - 1);
+    for(unsigned i = 0; i < candidates.size(); ++i)
+    {
+        if(roll < weights[i])
+        {
+            return candidates[i].dir;
+        }
+        roll -= weights[i];
+    }
+    return candidates.back().dir; // unreachable
