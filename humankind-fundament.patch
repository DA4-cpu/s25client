diff --git a/libs/s25main/civ/PlayerResearch.cpp b/libs/s25main/civ/PlayerResearch.cpp
new file mode 100644
index 000000000..caed910ce
--- /dev/null
+++ b/libs/s25main/civ/PlayerResearch.cpp
@@ -0,0 +1,130 @@
+// Copyright (C) 2026 DA4-cpu
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "civ/PlayerResearch.h"
+#include "SerializedGameData.h"
+#include "helpers/serializeEnums.h"
+#include "s25util/Log.h"
+#include <algorithm>
+
+namespace civ {
+
+unsigned PlayerResearch::GetNumResearched() const
+{
+    return static_cast<unsigned>(std::count(researched_.begin(), researched_.end(), true));
+}
+
+const PlayerResearch::Progress* PlayerResearch::GetProgress(TechIdx tech) const
+{
+    const auto it = progress_.find(tech);
+    return it == progress_.end() ? nullptr : &it->second;
+}
+
+PlayerResearch::Progress& PlayerResearch::GetOrCreateProgress(const TechTree& techTree, TechIdx tech)
+{
+    Progress& progress = progress_[tech];
+    progress.paid.resize(techTree.get(tech).cost.size(), 0u);
+    return progress;
+}
+
+std::optional<PlayerResearch::Progress> PlayerResearch::RemoveProgress(TechIdx tech)
+{
+    const auto it = progress_.find(tech);
+    if(it == progress_.end())
+        return std::nullopt;
+    Progress result = std::move(it->second);
+    progress_.erase(it);
+    return result;
+}
+
+void PlayerResearch::SetResearched(TechIdx tech)
+{
+    if(researched_.size() <= tech)
+        researched_.resize(tech + 1, false);
+    researched_[tech] = true;
+    progress_.erase(tech);
+    if(current_ == tech)
+        current_.reset();
+}
+
+// Technologies are stored by name and costs by good type so that changes of the (Lua) tech tree
+// don't break existing savegames. Unknown technologies are dropped when loading.
+void PlayerResearch::Serialize(SerializedGameData& sgd, const TechTree& techTree) const
+{
+    std::vector<TechIdx> researchedTechs;
+    for(TechIdx i = 0; i < researched_.size(); ++i)
+    {
+        if(researched_[i])
+            researchedTechs.push_back(i);
+    }
+    sgd.PushUnsignedInt(static_cast<unsigned>(researchedTechs.size()));
+    for(const TechIdx tech : researchedTechs)
+        sgd.PushString(techTree.get(tech).name);
+
+    sgd.PushString(current_ ? techTree.get(*current_).name : std::string());
+
+    sgd.PushUnsignedInt(static_cast<unsigned>(progress_.size()));
+    for(const auto& entry : progress_)
+    {
+        const Technology& tech = techTree.get(entry.first);
+        sgd.PushString(tech.name);
+        sgd.PushUnsignedInt(entry.second.researchedGFs);
+        sgd.PushUnsignedInt(static_cast<unsigned>(tech.cost.size()));
+        for(unsigned i = 0; i < tech.cost.size(); ++i)
+        {
+            helpers::pushEnum<uint8_t>(sgd, tech.cost[i].good);
+            sgd.PushUnsignedInt(entry.second.paid.at(i));
+        }
+    }
+}
+
+void PlayerResearch::Deserialize(SerializedGameData& sgd, const TechTree& techTree)
+{
+    researched_.clear();
+    current_.reset();
+    progress_.clear();
+
+    const unsigned numResearched = sgd.PopUnsignedInt();
+    for(unsigned i = 0; i < numResearched; ++i)
+    {
+        const std::string name = sgd.PopString();
+        if(const auto tech = techTree.find(name))
+            SetResearched(*tech);
+        else
+            LOG.write("Savegame: Ignoring unknown researched technology '%1%'\n") % name;
+    }
+
+    const std::string currentName = sgd.PopString();
+    if(!currentName.empty())
+        current_ = techTree.find(currentName);
+
+    const unsigned numProgress = sgd.PopUnsignedInt();
+    for(unsigned i = 0; i < numProgress; ++i)
+    {
+        const std::string name = sgd.PopString();
+        const unsigned researchedGFs = sgd.PopUnsignedInt();
+        const unsigned numCosts = sgd.PopUnsignedInt();
+        const auto tech = techTree.find(name);
+        Progress* progress = nullptr;
+        if(tech && !IsResearched(*tech))
+        {
+            progress = &GetOrCreateProgress(techTree, *tech);
+            progress->researchedGFs = researchedGFs;
+        }
+        for(unsigned j = 0; j < numCosts; ++j)
+        {
+            const auto good = helpers::popEnum<GoodType>(sgd);
+            const unsigned paid = sgd.PopUnsignedInt();
+            if(!progress)
+                continue;
+            // Cost entries may have changed -> match by good and never store more than needed
+            if(const auto costIdx = techTree.get(*tech).GetCostIdx(good))
+                progress->paid[*costIdx] = std::min(paid, techTree.get(*tech).cost[*costIdx].amount);
+        }
+    }
+    if(current_ && IsResearched(*current_))
+        current_.reset();
+}
+
+} // namespace civ
diff --git a/libs/s25main/civ/PlayerResearch.h b/libs/s25main/civ/PlayerResearch.h
new file mode 100644
index 000000000..5d357619a
--- /dev/null
+++ b/libs/s25main/civ/PlayerResearch.h
@@ -0,0 +1,52 @@
+// Copyright (C) 2026 DA4-cpu
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "civ/TechTree.h"
+#include <map>
+#include <optional>
+#include <vector>
+
+class SerializedGameData;
+
+namespace civ {
+
+/// Research state of a single player in the civilization mode
+class PlayerResearch
+{
+public:
+    /// Progress of a technology which was (partially) paid but not yet completed
+    struct Progress
+    {
+        /// Amount paid for each cost entry of the technology (same order as Technology::cost)
+        std::vector<unsigned> paid;
+        /// Game frames spent researching this technology
+        unsigned researchedGFs = 0;
+    };
+
+    bool IsResearched(TechIdx tech) const { return tech < researched_.size() && researched_[tech]; }
+    unsigned GetNumResearched() const;
+    const std::optional<TechIdx>& GetCurrent() const { return current_; }
+    /// Progress of the technology or nullptr if nothing was paid yet
+    const Progress* GetProgress(TechIdx tech) const;
+
+    void SetCurrent(std::optional<TechIdx> tech) { current_ = tech; }
+    /// Get progress of the technology, creating it if required
+    Progress& GetOrCreateProgress(const TechTree& techTree, TechIdx tech);
+    /// Remove the progress of the technology and return what was paid
+    std::optional<Progress> RemoveProgress(TechIdx tech);
+    /// Mark the technology as researched. Removes its progress and resets current research if it was this tech
+    void SetResearched(TechIdx tech);
+
+    void Serialize(SerializedGameData& sgd, const TechTree& techTree) const;
+    void Deserialize(SerializedGameData& sgd, const TechTree& techTree);
+
+private:
+    std::vector<bool> researched_;
+    std::optional<TechIdx> current_;
+    std::map<TechIdx, Progress> progress_;
+};
+
+} // namespace civ
diff --git a/libs/s25main/civ/Research.cpp b/libs/s25main/civ/Research.cpp
new file mode 100644
index 000000000..444d12e5f
--- /dev/null
+++ b/libs/s25main/civ/Research.cpp
@@ -0,0 +1,286 @@
+// Copyright (C) 2026 DA4-cpu
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "civ/Research.h"
+#include "EventManager.h"
+#include "GamePlayer.h"
+#include "GlobalGameSettings.h"
+#include "addons/const_addons.h"
+#include "buildings/nobBaseWarehouse.h"
+#include "civ/PlayerResearch.h"
+#include "helpers/EnumRange.h"
+#include "helpers/containerUtils.h"
+#include "helpers/format.hpp"
+#include "postSystem/PostMsg.h"
+#include "world/GameWorld.h"
+#include "gameTypes/Inventory.h"
+#include "s25util/Log.h"
+#include <limits>
+#include <memory>
+
+namespace civ {
+
+bool isEnabled(const GameWorldBase& world)
+{
+    return world.GetGGS().isEnabled(AddonId::CIVILIZATION);
+}
+
+std::optional<unsigned> getExclusiveOwner(const GameWorldBase& world, TechIdx tech)
+{
+    if(!world.GetTechTree().get(tech).exclusive)
+        return std::nullopt;
+    for(unsigned i = 0; i < world.GetNumPlayers(); ++i)
+    {
+        if(world.GetPlayer(i).GetResearch().IsResearched(tech))
+            return i;
+    }
+    return std::nullopt;
+}
+
+TechState getTechState(const GameWorldBase& world, unsigned playerId, TechIdx tech)
+{
+    const PlayerResearch& research = world.GetPlayer(playerId).GetResearch();
+    if(research.IsResearched(tech))
+        return TechState::Researched;
+    const Technology& technology = world.GetTechTree().get(tech);
+    if(technology.requiredAddon && !world.GetGGS().isEnabled(*technology.requiredAddon))
+        return TechState::Unavailable;
+    if(getExclusiveOwner(world, tech))
+        return TechState::TakenByOther;
+    for(const TechIdx req : technology.requirements)
+    {
+        if(!research.IsResearched(req))
+            return TechState::MissingRequirements;
+    }
+    if(research.GetCurrent() == tech)
+        return TechState::InProgress;
+    return TechState::Available;
+}
+
+bool canResearch(const GameWorldBase& world, unsigned playerId, TechIdx tech)
+{
+    const TechState state = getTechState(world, playerId, tech);
+    return state == TechState::Available || state == TechState::InProgress;
+}
+
+void applyBuildingAvailability(GamePlayer& player)
+{
+    const TechTree& techTree = player.GetGameWorld().GetTechTree();
+    for(const auto bld : helpers::enumRange<BuildingType>())
+    {
+        if(techTree.IsLockedAtStart(bld))
+            player.DisableBuilding(bld);
+    }
+    const PlayerResearch& research = player.GetResearch();
+    for(TechIdx tech = 0; tech < techTree.size(); ++tech)
+    {
+        if(!research.IsResearched(tech))
+            continue;
+        for(const BuildingType bld : techTree.get(tech).unlockedBuildings)
+            player.EnableBuilding(bld);
+    }
+}
+
+void startGame(GameWorld& world)
+{
+    if(!isEnabled(world))
+        return;
+    for(unsigned i = 0; i < world.GetNumPlayers(); ++i)
+        applyBuildingAvailability(world.GetPlayer(i));
+}
+
+bool setResearch(GameWorld& world, unsigned playerId, std::optional<TechIdx> tech)
+{
+    if(!isEnabled(world))
+        return false;
+    PlayerResearch& research = world.GetPlayer(playerId).GetResearch();
+    if(!tech)
+    {
+        research.SetCurrent(std::nullopt);
+        return true;
+    }
+    if(*tech >= world.GetTechTree().size() || !canResearch(world, playerId, *tech))
+        return false;
+    research.SetCurrent(tech);
+    return true;
+}
+
+namespace {
+    /// Take up to `amount` wares from the warehouses of the player. Returns the number of wares taken
+    unsigned takeWaresFromWarehouses(GamePlayer& player, GoodType good, unsigned amount)
+    {
+        unsigned taken = 0;
+        for(nobBaseWarehouse* wh : player.GetBuildingRegister().GetStorehouses())
+        {
+            if(taken >= amount)
+                break;
+            taken += wh->TakeWares(good, amount - taken);
+        }
+        return taken;
+    }
+
+    /// Return the paid costs to the first warehouse of the player (if any)
+    void refund(GamePlayer& player, const Technology& tech, const PlayerResearch::Progress& progress)
+    {
+        nobBaseWarehouse* wh = player.GetFirstWH();
+        if(!wh)
+            return;
+        GoodCounts goods;
+        for(unsigned i = 0; i < tech.cost.size(); ++i)
+            goods[tech.cost[i].good] += progress.paid.at(i);
+        wh->AddToInventory(goods, true);
+    }
+
+    void sendMessage(GameWorld& world, unsigned playerId, const std::string& text)
+    {
+        world.GetPlayer(playerId).SendPostMessage(
+          std::make_unique<PostMsg>(world.GetEvMgr().GetCurrentGF(), text, PostCategory::Economy));
+    }
+} // namespace
+
+void completeResearch(GameWorld& world, unsigned playerId, TechIdx tech)
+{
+    const TechTree& techTree = world.GetTechTree();
+    const Technology& technology = techTree.get(tech);
+    GamePlayer& player = world.GetPlayer(playerId);
+    PlayerResearch& research = player.GetResearch();
+    if(research.IsResearched(tech))
+        return;
+    research.SetResearched(tech);
+    for(const BuildingType bld : technology.unlockedBuildings)
+        player.EnableBuilding(bld);
+    sendMessage(world, playerId, helpers::format(_("Forschung abgeschlossen: %1%"), _(technology.title)));
+
+    if(!technology.exclusive)
+        return;
+    // Nobody else can get this technology anymore
+    for(unsigned i = 0; i < world.GetNumPlayers(); ++i)
+    {
+        if(i == playerId)
+            continue;
+        GamePlayer& otherPlayer = world.GetPlayer(i);
+        PlayerResearch& otherResearch = otherPlayer.GetResearch();
+        const bool wasResearching = otherResearch.GetCurrent() == tech;
+        if(wasResearching)
+            otherResearch.SetCurrent(std::nullopt);
+        if(const auto progress = otherResearch.RemoveProgress(tech))
+            refund(otherPlayer, technology, *progress);
+        if(wasResearching)
+        {
+            sendMessage(world, i,
+                        helpers::format(_("%1% hat \"%2%\" zuerst erforscht. Bereits bezahlte Waren wurden erstattet."),
+                                        player.name, _(technology.title)));
+        }
+    }
+}
+
+void update(GameWorld& world, unsigned numGFs)
+{
+    if(!isEnabled(world))
+        return;
+    const TechTree& techTree = world.GetTechTree();
+    for(unsigned playerId = 0; playerId < world.GetNumPlayers(); ++playerId)
+    {
+        GamePlayer& player = world.GetPlayer(playerId);
+        if(!player.isUsed() || player.IsDefeated())
+            continue;
+        PlayerResearch& research = player.GetResearch();
+        const std::optional<TechIdx> current = research.GetCurrent();
+        if(!current)
+            continue;
+        if(!canResearch(world, playerId, *current))
+        {
+            // Should not happen (exclusive techs are handled on completion) but be safe
+            research.SetCurrent(std::nullopt);
+            continue;
+        }
+        const Technology& tech = techTree.get(*current);
+        PlayerResearch::Progress& progress = research.GetOrCreateProgress(techTree, *current);
+        progress.researchedGFs += numGFs;
+        bool allPaid = true;
+        for(unsigned i = 0; i < tech.cost.size(); ++i)
+        {
+            unsigned& paid = progress.paid[i];
+            if(paid < tech.cost[i].amount)
+                paid += takeWaresFromWarehouses(player, tech.cost[i].good, tech.cost[i].amount - paid);
+            if(paid < tech.cost[i].amount)
+                allPaid = false;
+        }
+        if(allPaid && progress.researchedGFs >= tech.minResearchGFs)
+            completeResearch(world, playerId, *current);
+    }
+}
+
+bool isAffordable(const GameWorldBase& world, unsigned playerId, TechIdx tech)
+{
+    const Technology& technology = world.GetTechTree().get(tech);
+    const GamePlayer& player = world.GetPlayer(playerId);
+    const PlayerResearch::Progress* progress = player.GetResearch().GetProgress(tech);
+    for(unsigned i = 0; i < technology.cost.size(); ++i)
+    {
+        const unsigned paid = progress ? progress->paid.at(i) : 0u;
+        if(paid >= technology.cost[i].amount)
+            continue;
+        unsigned stock = 0;
+        for(const nobBaseWarehouse* wh : player.GetBuildingRegister().GetStorehouses())
+            stock += wh->GetNumRealWares(technology.cost[i].good);
+        if(stock < technology.cost[i].amount - paid)
+            return false;
+    }
+    return true;
+}
+
+unsigned getAmountPaid(const GameWorldBase& world, unsigned playerId, TechIdx tech)
+{
+    const PlayerResearch::Progress* progress = world.GetPlayer(playerId).GetResearch().GetProgress(tech);
+    unsigned result = 0;
+    if(progress)
+    {
+        for(const unsigned paid : progress->paid)
+            result += paid;
+    }
+    return result;
+}
+
+std::optional<TechIdx> chooseResearchForAI(const GameWorldBase& world, unsigned playerId,
+                                           std::optional<TechIdx> exclude)
+{
+    const TechTree& techTree = world.GetTechTree();
+    std::optional<TechIdx> best;
+    bool bestAffordable = false;
+    for(TechIdx tech = 0; tech < techTree.size(); ++tech)
+    {
+        if(tech == exclude)
+            continue;
+        const TechState state = getTechState(world, playerId, tech);
+        if(state != TechState::Available && state != TechState::InProgress)
+            continue;
+        const bool affordable = isAffordable(world, playerId, tech);
+        if(!best)
+        {
+            best = tech;
+            bestAffordable = affordable;
+            continue;
+        }
+        const Technology& cur = techTree.get(tech);
+        const Technology& bestTech = techTree.get(*best);
+        bool isBetter;
+        if(affordable != bestAffordable)
+            isBetter = affordable;
+        else if(cur.aiPriority != bestTech.aiPriority)
+            isBetter = cur.aiPriority > bestTech.aiPriority;
+        else if(cur.GetTotalCost() != bestTech.GetTotalCost())
+            isBetter = cur.GetTotalCost() < bestTech.GetTotalCost();
+        else
+            isBetter = cur.era < bestTech.era;
+        if(isBetter)
+        {
+            best = tech;
+            bestAffordable = affordable;
+        }
+    }
+    return best;
+}
+
+} // namespace civ
diff --git a/libs/s25main/civ/Research.h b/libs/s25main/civ/Research.h
new file mode 100644
index 000000000..cf77f5f5e
--- /dev/null
+++ b/libs/s25main/civ/Research.h
@@ -0,0 +1,63 @@
+// Copyright (C) 2026 DA4-cpu
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "civ/TechTree.h"
+#include <optional>
+
+class GamePlayer;
+class GameWorld;
+class GameWorldBase;
+
+/// Game logic of the civilization mode (tech tree & research)
+namespace civ {
+
+/// Interval in game frames in which research costs are paid (2s at normal speed)
+constexpr unsigned RESEARCH_UPDATE_INTERVAL = 40;
+
+/// True if the civilization mode (tech tree) is active in this game
+bool isEnabled(const GameWorldBase& world);
+
+enum class TechState
+{
+    /// Not part of this game (required addon disabled)
+    Unavailable,
+    Researched,
+    InProgress,
+    Available,
+    MissingRequirements,
+    /// Exclusive technology already researched by another player
+    TakenByOther
+};
+
+/// Player who researched the exclusive technology or nullopt if none (or it is not exclusive)
+std::optional<unsigned> getExclusiveOwner(const GameWorldBase& world, TechIdx tech);
+TechState getTechState(const GameWorldBase& world, unsigned playerId, TechIdx tech);
+/// True if the player can start researching this technology
+bool canResearch(const GameWorldBase& world, unsigned playerId, TechIdx tech);
+
+/// Enable/disable buildings of the player according to its research. Call at game start and after loading
+void applyBuildingAvailability(GamePlayer& player);
+/// Initialize the civilization mode for all players at game start (new game or loaded). Noop if not enabled
+void startGame(GameWorld& world);
+
+/// Set the current research of the player (nullopt to stop researching). Returns false if not possible
+bool setResearch(GameWorld& world, unsigned playerId, std::optional<TechIdx> tech);
+/// Pay research costs from the warehouses and complete technologies. Called every RESEARCH_UPDATE_INTERVAL GFs
+void update(GameWorld& world, unsigned numGFs = RESEARCH_UPDATE_INTERVAL);
+/// Complete the technology for the player (unlocks buildings, handles exclusivity)
+void completeResearch(GameWorld& world, unsigned playerId, TechIdx tech);
+
+/// True if the remaining costs of the technology can be paid from the current stock of the warehouses
+bool isAffordable(const GameWorldBase& world, unsigned playerId, TechIdx tech);
+/// Sum of all wares already paid for the technology
+unsigned getAmountPaid(const GameWorldBase& world, unsigned playerId, TechIdx tech);
+
+/// Choose a technology for the AI to research (ignoring `exclude`):
+/// Affordable ones first, then highest priority, then cheapest, then lowest era
+std::optional<TechIdx> chooseResearchForAI(const GameWorldBase& world, unsigned playerId,
+                                           std::optional<TechIdx> exclude = std::nullopt);
+
+} // namespace civ
diff --git a/libs/s25main/civ/TechTree.cpp b/libs/s25main/civ/TechTree.cpp
new file mode 100644
index 000000000..2efd90734
--- /dev/null
+++ b/libs/s25main/civ/TechTree.cpp
@@ -0,0 +1,126 @@
+// Copyright (C) 2026 DA4-cpu
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "civ/TechTree.h"
+#include "civ/Identifiers.h"
+#include "RttrConfig.h"
+#include "files.h"
+#include "helpers/containerUtils.h"
+#include "gameData/GameConsts.h"
+#include "gameData/WorldDescription.h"
+#include "lua/GameDataLoader.h"
+#include <algorithm>
+#include <chrono>
+
+namespace civ {
+
+unsigned Technology::GetTotalCost() const
+{
+    unsigned result = 0;
+    for(const TechCost& c : cost)
+        result += c.amount;
+    return result;
+}
+
+std::optional<unsigned> Technology::GetCostIdx(GoodType good) const
+{
+    for(unsigned i = 0; i < cost.size(); ++i)
+    {
+        if(cost[i].good == good)
+            return i;
+    }
+    return std::nullopt;
+}
+
+TechTree::TechTree(const WorldDescription& desc)
+{
+    std::fill(lockedAtStart_.begin(), lockedAtStart_.end(), false);
+    techs_.reserve(desc.technologies.size());
+    for(const TechnologyDesc& techDesc : desc.technologies)
+    {
+        Technology tech;
+        tech.name = techDesc.name;
+        tech.title = techDesc.title;
+        tech.description = techDesc.description;
+        tech.era = techDesc.era;
+        for(const std::string& req : techDesc.requirements)
+        {
+            const auto reqIdx = find(req);
+            // Checked by the loader already
+            if(!reqIdx)
+                throw GameDataError("Technology '" + tech.name + "' requires unknown technology '" + req + "'");
+            tech.requirements.push_back(*reqIdx);
+        }
+        for(const auto& entry : techDesc.cost)
+        {
+            const auto good = goodFromIdentifier(entry.first);
+            if(!good)
+                throw GameDataError("Technology '" + tech.name + "' has an invalid cost good '" + entry.first + "'");
+            tech.cost.push_back(TechCost{*good, entry.second});
+        }
+        std::sort(tech.cost.begin(), tech.cost.end(),
+                  [](const TechCost& lhs, const TechCost& rhs) { return lhs.good < rhs.good; });
+        tech.minResearchGFs = static_cast<unsigned>(duration_to_gfs(std::chrono::seconds(techDesc.time)));
+        for(const std::string& bldName : techDesc.unlockedBuildings)
+        {
+            const auto bld = buildingFromIdentifier(bldName);
+            if(!bld)
+                throw GameDataError("Technology '" + tech.name + "' unlocks an invalid building '" + bldName + "'");
+            if(!helpers::contains(tech.unlockedBuildings, *bld))
+                tech.unlockedBuildings.push_back(*bld);
+            lockedAtStart_[*bld] = true;
+        }
+        tech.exclusive = techDesc.exclusive;
+        if(!techDesc.requiredAddon.empty())
+        {
+            for(const AddonId id : rttrEnum::values<AddonId>)
+            {
+                if(rttrEnum::toString(id) == techDesc.requiredAddon)
+                    tech.requiredAddon = id;
+            }
+            if(!tech.requiredAddon)
+                throw GameDataError("Technology '" + tech.name + "' requires an invalid addon '"
+                                    + techDesc.requiredAddon + "'");
+        }
+        tech.aiPriority = techDesc.aiPriority;
+        techs_.push_back(std::move(tech));
+    }
+}
+
+std::optional<TechIdx> TechTree::find(const std::string& name) const
+{
+    for(TechIdx i = 0; i < techs_.size(); ++i)
+    {
+        if(techs_[i].name == name)
+            return i;
+    }
+    return std::nullopt;
+}
+
+std::vector<TechIdx> TechTree::GetTechsUnlocking(BuildingType bld) const
+{
+    std::vector<TechIdx> result;
+    for(TechIdx i = 0; i < techs_.size(); ++i)
+    {
+        if(helpers::contains(techs_[i].unlockedBuildings, bld))
+            result.push_back(i);
+    }
+    return result;
+}
+
+TechTree loadTechTree(const boost::filesystem::path& folder)
+{
+    WorldDescription desc;
+    GameDataLoader loader(desc, folder);
+    if(!loader.Load())
+        throw GameDataLoadError("Could not load the tech tree from " + folder.string());
+    return TechTree(desc);
+}
+
+TechTree loadDefaultTechTree()
+{
+    return loadTechTree(RTTRCONFIG.ExpandPath(s25::folders::gamedata) / "civ");
+}
+
+} // namespace civ
