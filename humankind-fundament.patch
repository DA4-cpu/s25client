+// Copyright (C) 2026 DA4-cpu
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "IngameWindow.h"
+#include "civ/TechTree.h"
+#include <optional>
+#include <string>
+
+class GameCommandFactory;
+class GameWorldViewer;
