+                          BuildingType::Barracks, BuildingType::Guardhouse, BuildingType::LookoutTower})
+        BOOST_TEST(!techTree.IsLockedAtStart(bld));
+    // Every other building can be researched
+    for(const auto bld : helpers::enumRange<BuildingType>())
