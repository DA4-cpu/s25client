+MapPoint AIPlayerJH::FindServingForesterPos(const MapPoint& pt) const
+{
+    MapPoint nearestPos = MapPoint::Invalid();
+    unsigned nearestDist = RES_RADIUS[AIResource::Wood] + 1; // must be within radius to count at all
+
+    const auto consider = [&](const MapPoint& foresterPos) {
+        const unsigned dist = gwb.CalcDistance(pt, foresterPos);
+        if(dist <= RES_RADIUS[AIResource::Wood] && dist < nearestDist)
+        {
+            nearestDist = dist;
+            nearestPos = foresterPos;
+        }
+    };
+
+    for(const nobUsual* forester : aii.GetBuildings(BuildingType::Forester))
+        consider(forester->GetPos());
+    // Also consider foresters that are still being built: a woodcutter placed just before
+    // such a forester finishes should be counted against it too, otherwise both would be
+    // planned independently and the forester could end up with more than its 2 woodcutters.
+    for(const noBuildingSite* site : aii.GetBuildingSites())
+    {
+        if(site->GetBuildingType() == BuildingType::Forester)
+            consider(site->GetPos());
+    }
+    return nearestPos;
+}
+
+unsigned AIPlayerJH::CountWoodcuttersServing(const MapPoint& foresterPos) const
+{
+    unsigned count = 0;
+    const auto belongsHere = [&](const MapPoint& woodcutterPos) {
+        return FindServingForesterPos(woodcutterPos) == foresterPos;
+    };
+
+    for(const nobUsual* woodcutter : aii.GetBuildings(BuildingType::Woodcutter))
+    {
+        if(belongsHere(woodcutter->GetPos()))
+            ++count;
+    }
+    // Count building sites too so multiple build jobs resolved in the same game frame
+    // (or before the previous woodcutter site has finished) don't overshoot the target.
+    for(const noBuildingSite* site : aii.GetBuildingSites())
+    {
+        if(site->GetBuildingType() == BuildingType::Woodcutter && belongsHere(site->GetPos()))
+            ++count;
+    }
+    return count;
+}
